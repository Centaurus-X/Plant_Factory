          {
            "path": "when.value",
            "reason": "param_of_state beim Einfuegen setzen",
            "source": "max_pressure*0.9",
            "key": "max_pressure",
            "set": [
              "param_of_state"
            ],
            "scale": 0.9
          }
        ],
        "notes": [
          "Formel 'max_pressure*0.9' wird beim Einfuegen zu {param_of_state, key, scale} — bis dahin steht ein neutraler Zahlenwert.",
          "Aktion 'emergency_shutdown' liess sich nicht in eine V9-Aktion uebersetzen.",
          "Ohne uebersetzbare Aktion wurde eine notify-Aktion eingesetzt."
        ]
      },
      "rule": {
        "engine_id": 1,
        "execution_epoch": 1,
        "deployment_status": "active_node",
        "activation_state": "active",
        "group": "process",
        "priority": 5,
        "name": "emergency_cool_on_overpressure",
        "enabled": true,
        "when": [
          {
            "src": "sensor",
            "op": ">",
            "value": 0
          }
        ],
        "description": "",
        "do": [
          {
            "notify": "emergency_cool_on_overpressure"
          }
        ]
      }
    },
