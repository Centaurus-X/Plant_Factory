{
  "version": 9,
  "kind": "rule_templates",
  "description": "V9-Regelvorlagen, erzeugt aus rule_library.json durch _tools/convert_libraries_to_v9.py. Identitaetsfelder sind null und werden beim Einfuegen aus dem Zielkontext vergeben.",
  "templates": [
    {
      "__template__": {
        "source_set": "process_rules",
        "source_rule_id": "notify_heating_ready",
        "evaluation": "on_event",
        "fill_on_insert": [
          "rule_id",
          "owner_node_id",
          "execution_owner",
          "execution_scope",
          "activation_state",
          "deployment_status"
        ],
        "deferred": [
          {
            "path": "when[0]",
            "reason": "Sensoridentitaet beim Einfuegen waehlen",
            "set": [
              "controller_uuid",
              "sensor_id"
            ],
            "sensor_type": "temperature"
          },
          {
            "path": "when[0].value",
            "reason": "param_of_state beim Einfuegen setzen",
            "source": "target_temp*0.98",
            "key": "target_temp",
            "set": [
              "param_of_state"
            ],
            "scale": 0.98
          },
          {
            "path": "when[1]",
            "reason": "state_type auf eine konkrete state_id abbilden",
            "state_type": "heating",
            "attribute": "active",
            "set": [
              "state_id"
            ]
          }
        ],
        "notes": [
          "Formel 'target_temp*0.98' wird beim Einfuegen zu {param_of_state, key, scale} — bis dahin steht ein neutraler Zahlenwert.",
          "Bedingung ueber state_type 'heating' braucht beim Einfuegen eine konkrete state_id."
        ]
      },
      "rule": {
        "engine_id": 1,
        "execution_epoch": 1,
        "deployment_status": "active_node",
        "activation_state": "active",
        "group": "process",
        "priority": 5,
        "name": "notify_heating_ready",
        "enabled": true,
        "when": [
          {
            "src": "sensor",
            "op": ">=",
            "value": 0
          },
          {
            "src": "state",
            "op": "==",
            "field": "value_id",
            "value": 1
          }
        ],
        "description": "",
        "do": [
          {
            "notify": "Heating reached nominal range. Consider starting stirring."
          }
        ]
      }
    },
    {
