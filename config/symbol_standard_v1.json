{
  "compatibility": {
    "automatic_normalization": "non_destructive",
    "custom_svg_content_preserved": true,
    "existing_bindings_preserved": true,
    "existing_connections_preserved": true,
    "existing_hmi_widgets_preserved": true,
    "legacy_template_ids_preserved": true,
    "unknown_fields_preserved": true
  },
  "connection_types": {
    "data": {
      "accepted_port_kinds": [
        "data",
        "io"
      ],
      "default_width": 1.6,
      "marker": "open",
      "routing": "orthogonal"
    },
    "pipe": {
      "accepted_port_kinds": [
        "process",
        "utility"
      ],
      "default_width": 2.4,
      "marker": "flow",
      "routing": "orthogonal"
    },
    "power": {
      "accepted_port_kinds": [
        "power"
      ],
      "default_width": 1.8,
      "marker": "open",
      "routing": "orthogonal"
    },
    "signal": {
      "accepted_port_kinds": [
        "signal",
        "io"
      ],
      "default_width": 1.6,
      "marker": "open",
      "routing": "orthogonal"
    }
  },
  "coordinate_system": {
    "base_grid": 10,
    "connection_grid": 5,
    "minimum_hit_size": 24,
    "pivot": "center",
    "preserve_aspect_ratio": "xMidYMid meet",
    "unit": "engineering_px"
  },
  "geometry": {
    "description_font_size": 8.5,
    "label_gap": 12,
    "port_radius": 3.2,
    "primary_stroke_width": 2.2,
    "process_line_width": 2.4,
    "secondary_stroke_width": 1.4,
    "selection_port_radius": 4.2,
    "signal_line_width": 1.6,
    "tag_font_size": 11,
    "vector_effect": "non-scaling-stroke"
  },
  "hmi_controls": {
    "auto_binding": false,
    "available": [
      "text",
      "indicator",
      "toggle",
      "button",
      "slider"
    ],
    "button_policy": "optional_explicit_only",
    "default": null,
    "process_symbol_drop_policy": "never_create_control"
  },
  "interaction_defaults": {
    "animatable": true,
    "auto_create_hmi_widgets": false,
    "bindable": true,
    "configurable": true,
    "connectable": true,
    "movable": true,
    "resizable": true,
    "rotatable": true,
    "selectable": true,
    "show_hmi_overlay_in_engineering": false
  },
  "label_contract": {
    "fallback_tag_start": 101,
    "line_1": "tag",
    "line_2": "display_name",
    "tag_pattern": "^[A-Z][A-Z0-9]{0,5}-[0-9]{3}[A-Z]?$",
    "upright_after_rotation": true
  },
  "library": {
    "category_order": [
      "Behälter",
